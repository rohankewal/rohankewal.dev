---
import HeaderLink from "./HeaderLink.astro";

const today = new Date();
---

<footer class="border-t border-gray-200 dark:border-gray-800 mt-16">
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-6">
        <HeaderLink href="/" class="font-semibold text-sm">Rohan Kewalramani</HeaderLink>
        <HeaderLink href="/blog" class="text-sm">Posts</HeaderLink>
        <HeaderLink href="/about" class="text-sm">About</HeaderLink>
        <HeaderLink href="/setup" class="text-sm">Setup</HeaderLink>
      </div>
      <p class="text-gray-400 dark:text-gray-500 text-sm">&copy; {today.getFullYear()}</p>
    </div>
  </div>
</footer>
