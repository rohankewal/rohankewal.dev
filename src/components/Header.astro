---
import HeaderLink from "./HeaderLink.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import TwitterIcon from "./icons/TwitterIcon.astro";
---

<header class="border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
    <HeaderLink href="/" class="no-underline">
      <h2 class="font-semibold text-lg text-gray-900 dark:text-gray-100 hover:text-gray-900">Rohan Kewalramani</h2>
    </HeaderLink>
    <div class="flex items-center gap-6">
      <nav class="hidden md:flex items-center gap-6">
        <HeaderLink href="/blog">Posts</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
        <HeaderLink href="/setup">Setup</HeaderLink>
      </nav>
      <div class="hidden md:flex items-center gap-3">
        <a href="https://www.twitter.com/rohankewal" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
          <TwitterIcon class="w-5" />
        </a>
        <a href="https://www.github.com/rohankewal" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
          <GithubIcon class="w-5" />
        </a>
      </div>
      <button class="mobile-menu-button md:hidden text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu hidden md:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
    <nav class="max-w-5xl mx-auto px-4 py-3 flex flex-col gap-3">
      <HeaderLink href="/blog">Posts</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <HeaderLink href="/setup">Setup</HeaderLink>
      <div class="flex gap-3 pt-2 border-t border-gray-100 dark:border-gray-800">
        <a href="https://www.twitter.com/rohankewal" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
          <TwitterIcon class="w-5" />
        </a>
        <a href="https://www.github.com/rohankewal" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
          <GithubIcon class="w-5" />
        </a>
      </div>
    </nav>
  </div>
</header>
<script>
  const mobileMenuButton = document.querySelector('.mobile-menu-button');
  const mobileMenu = document.querySelector('.mobile-menu');

  mobileMenuButton.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
  });
</script>
